# Copy to .env for local development: cp .env.example .env
# Services validate these on startup and exit with a list of problems.

# development | test | production (default: development)
NODE_ENV=development

# fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=debug

# PostgreSQL connection string. Matches infrastructure/compose/dev.yml.
DATABASE_URL=postgres://petri:petri@localhost:5432/petri

# API listen address and port (defaults: 127.0.0.1, 4000).
# Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=4000

# Public URL of the admin panel; used for cookies, redirects and origin
# checks. In development, the web app's address.
PUBLIC_URL=http://localhost:3000

# Signs session cookies. At least 32 characters; generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Reverse proxies whose X-Forwarded-For header is trusted, comma-separated
# addresses or CIDRs. Browser requests reach the API through the web app,
# so include it (in development: 127.0.0.1,::1), plus the NPM VM in
# production. Empty: trust none, and all sign-ins count as one address
# for rate limiting.
TRUST_PROXY=127.0.0.1,::1

# Optional sign-in through an OpenID Connect provider (Authentik,
# Authelia, ...). Set all three or none. Register this redirect URI at the
# provider: <PUBLIC_URL>/api/v1/auth/callback/oidc
# The provider must report the owner's email address, verified.
# OIDC_ISSUER=https://auth.example.com/application/o/petri/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Where uploaded ZIP archives are kept; the API and worker must share it.
# Default (development only): a directory in the system temp folder.
# docker-compose.yml uses a volume instead.
# UPLOADS_DIR=

# BuildKit daemon used by the worker. `pnpm dev:infra` starts one on
# this address; docker-compose.yml sets its own.
# BUILDKIT_HOST=tcp://127.0.0.1:1234

# Where the web app reaches the API (server-side). Default:
# http://localhost:4000
# API_INTERNAL_URL=http://localhost:4000

# --- Docker Compose (docker-compose.yml) -----------------------------------
# The full stack reads PUBLIC_URL, AUTH_SECRET, LOG_LEVEL and the OIDC_*
# variables above, plus these. DATABASE_URL, API_* and TRUST_PROXY are set
# by docker-compose.yml itself.

# PostgreSQL password for the stack's database. Generate with:
#   openssl rand -hex 24
# POSTGRES_PASSWORD=

# Address and port the web app is published on. Only NPM should reach it.
# WEB_BIND=127.0.0.1
# WEB_PORT=3000

# Subnet of the stack's internal network (change if it collides).
# PETRI_SUBNET=172.31.250.0/24
