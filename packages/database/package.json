{
	"name": "@petri/database",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"exports": {
		".": {
			"@petri/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"@petri/source": "./test/helpers.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --conditions=@petri/source --env-file-if-exists=../../.env src/migrate-cli.ts"
	},
	"dependencies": {
		"@petri/config": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11"
	},
	"files": [
		"dist",
		"migrations"
	]
}
