{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"allowJs": false,
		"incremental": true,
		"types": ["node"],
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["next-env.d.ts", "src", ".next/types/**/*.ts", "next.config.ts"],
	"exclude": ["node_modules"]
}
