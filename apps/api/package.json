{
	"name": "@petri/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"dev": "node --conditions=@petri/source --env-file-if-exists=../../.env --watch src/main.ts",
		"start": "node dist/main.js",
		"owner:set": "node --conditions=@petri/source --env-file-if-exists=../../.env src/cli/set-owner.ts"
	},
	"dependencies": {
		"@fastify/swagger": "^9.9.3",
		"@fastify/swagger-ui": "^6.1.3",
		"@petri/config": "workspace:*",
		"@petri/contracts": "workspace:*",
		"@petri/database": "workspace:*",
		"better-auth": "^1.7.18",
		"drizzle-orm": "0.45.4",
		"fastify": "^5.12.8",
		"fastify-type-provider-zod": "^7.0.0",
		"openapi-types": "^12.1.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.19.2"
	}
}
